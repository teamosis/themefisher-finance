# Database Connection String for NeonDB
DATABASE_URL=postgresql://user:password@host.tld/dbname?sslmode=require


# Site Protection Password
AUTH_PASSWORD=change_this_to_your_secure_password
AUTH_SECRET=replace_with_a_long_random_signing_secret

# PDF Password
PDF_PASSWORD=pdf_password_here

# Application origin URL (e.g. http://localhost:3000 or https://finance.example.com)
NEXT_PUBLIC_APP_URL=https://finance.example.com
